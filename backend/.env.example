# ===== dreamforge backend environment variables =====
# Copy this file to `.env` and fill in real values.
#
#   cp .env.example .env

# Groq API key (used in Phase 2+ for theme labels, /dream and /explain).
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# LLM model name on Groq.
LLM_MODEL=llama-3.1-8b-instant

# Sentence-transformers model name for embeddings.
EMBED_MODEL=all-MiniLM-L6-v2

# Where ChromaDB persists its files (relative to the backend/ directory).
CHROMA_PERSIST_DIR=./data/chroma

# Where the derived graph snapshot lives.
GRAPH_CACHE_DIR=./data/graphs

# Where uploaded source files are staged (kept for recovery).
RAW_UPLOAD_DIR=./data/raw

# Chunking parameters. Characters are used as a rough token proxy
# (~4 chars ≈ 1 token for English prose). 1024 chars ≈ 256 tokens.
CHUNK_SIZE=1024
CHUNK_OVERLAP=120

# Hard cap on chunks the dreamspace can hold. Keeps the 3D scene
# responsive and bounds the cost of theme labeling.
MAX_CHUNKS_IN_DREAMSPACE=800

# Semantic graph parameters (used by Phase 2+).
KNN_K=8
SIM_FLOOR=0.55
HDBSCAN_MIN_CLUSTER_SIZE=4
UMAP_SEED=42

# CORS allowed origins (comma-separated). Default is the Vite dev server.
CORS_ORIGINS=http://localhost:5173
